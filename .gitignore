# --- Secrets & local config ---
.env
*.local

# --- Data (never versioned: landing zone, DuckDB warehouse, raw copies) ---
data/
*.duckdb
*.duckdb.wal
*.parquet
*.csv

# --- Airflow runtime ---
logs/

# --- dbt (build artifacts, installed packages, anonymous user id) ---
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/

# --- Private notes (interview prep, CV), never versioned ---
docs/*_private.md

# --- Assistant local settings (CLAUDE.md, the working rules, is versioned) ---
.claude/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
